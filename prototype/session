#!/bin/bash
# Start one of the three Claude Code sessions after a reboot (or any time):
#   session 1   operations : main checkout of ragon (benchmark runs, gate, releases, the real machine)
#   session 2   product    : worktree .claude/worktrees/product of ragon (code, tests, specs, docs)
#   session 3   ragon-engine: ~/projects/ragon-engine (builds and tests on second-node)
#   session 4   crew       : ~/projects/mighty-crew (the Mighty Crew product: spec and prototype)
# Each continues its most recent conversation in that directory; add --new for a fresh one.
# Names work too: session ops | product | engine | crew.
set -eu
REPO=$HOME/projects/dgxcoder
ENGINE=$HOME/projects/ragon-engine
CREW=$HOME/projects/mighty-crew
PRODUCT_WT=$REPO/.claude/worktrees/product

mode=--continue
for a in "$@"; do [ "$a" = --new ] && mode=""; done
which=${1:-}
# Every role runs in one permission class with prompts bypassed (the owner's decision, 2026-11-01), so a
# message from one session reaches another without being held; and each session carries its role's name.
PERMISSION="--permission-mode bypassPermissions"

case "$which" in
  1|ops|operations)
    role=operations
    cd "$REPO"
    git fetch -q origin || true
    echo "== operations session in $REPO ($(git branch --show-current) at $(git log --oneline -1 | cut -c1-60))"
    if ! systemctl --user is-active --quiet ragon-swe-run1 && ! systemctl --user is-active --quiet ragon-swe-run2; then
      echo "   No benchmark unit is running. After a reboot: 'ragon-admin server start' first, then re-run the benchmark's"
      echo "   start command (it resumes the run by name); the watcher cron must be re-armed in the session."
    fi
    ;;
  2|product)
    role=product
    if [ ! -d "$PRODUCT_WT" ]; then
      git -C "$REPO" fetch -q origin
      git -C "$REPO" worktree add -b work/product "$PRODUCT_WT" origin/main
    fi
    cd "$PRODUCT_WT"
    echo "== product session in $PRODUCT_WT ($(git branch --show-current) at $(git log --oneline -1 | cut -c1-60))"
    echo "   tests: ../../../.venv/bin/python -m pytest tests/ -q   (the venv lives in the main checkout)"
    ;;
  3|engine|ragon-engine)
    role=engine
    cd "$ENGINE"
    if [ -z "$(git status --porcelain)" ]; then git pull -q --ff-only || true; fi
    echo "== ragon-engine session in $ENGINE at $(git log --oneline -1 | cut -c1-60)"
    echo "   builds, tests and measurements only on second-node (ssh second-node)"
    ;;
  4|crew|mighty-crew)
    role=crew
    cd "$CREW"
    if [ -z "$(git status --porcelain)" ]; then git pull -q --ff-only || true; fi
    echo "== crew session in $CREW at $(git log --oneline -1 | cut -c1-60)"
    echo "   the Mighty Crew product: specs/DREAMFERENCE_MIGHTY_CREW.md, the prototype in prototype/, the binary in src/"
    ;;
  *)
    sed -n 2,8p "$0"; exit 2 ;;
esac
# The shared status board, so every stream starts knowing what the others did.
command -v session-note >/dev/null && { echo "-- status board (docs/dev/sessions.md), newest last:"; session-note 2>/dev/null | tail -n 6; }
# A directory with no conversation yet starts a fresh one (claude --continue refuses otherwise).
project_dir=$HOME/.claude/projects/$(pwd | sed 's|/|-|g')
if [ -n "$mode" ] && ! ls "$project_dir"/*.jsonl >/dev/null 2>&1; then
  echo "   (no conversation to continue here yet: starting a fresh one)"
  mode=""
fi
exec claude $mode $PERMISSION --name "$role"
